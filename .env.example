# 数据库面试练习库连接信息 - 模板
# ⚠️ 复制本文件为 .env 后填入实际值:
#     cp .env.example .env  &&  $EDITOR .env
# .env 已在 .gitignore 中,不会 commit;本文件作为提交版占位模板

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 从库（可选，只读实验实例；没有从库可以留空）
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DB_REPLICA_NAME=
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=
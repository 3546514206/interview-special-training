# ==========================================================================
#  spring-labs 部署配置样例
#
#  用法：cp .env.example .env 后按需修改。
#  本文件只允许出现主机名 / 端口 / 镜像名这类非敏感配置，
#  严禁写入密码、私钥内容或私钥路径。
# ==========================================================================

# --------------------------------------------------------------------------
# 业务 HTTP 端口（宿主机侧）。容器内固定 8080。
# --------------------------------------------------------------------------
APP_PORT=8080

# --------------------------------------------------------------------------
# JDWP 远程调试端口（宿主机侧）。容器内固定 5005。
# --------------------------------------------------------------------------
JDWP_PORT=5005

# --------------------------------------------------------------------------
# JDWP_BIND：决定 JDWP 端口在【宿主机】上的绑定地址。
#
#   0.0.0.0   = 公网直连（当前生效）。IDEA 直接连 <服务器IP>:5005，无需隧道。
#               ⚠️ 风险：JDWP 协议不加密，且等价于一个远程代码执行入口（RCE）。
#                  任何能连上该端口的人都能加载任意代码。
#                  【必须】同时在腾讯云控制台安全组把 5005 入方向来源 IP
#                  限制为你的固定出口 IP，否则等于把 RCE 入口暴露到公网。
#                  不放通时的现象：IDEA attach 一直转圈直到超时（connection timeout）。
#
#   127.0.0.1 = 仅本机可达（收紧方案，一键切换）。改回此值即恢复隧道模式：
#               ssh -N -L 5005:127.0.0.1:5005 -i <私钥> <用户>@<服务器IP>
#               IDEA 里 host=localhost、port=5005。
# --------------------------------------------------------------------------
JDWP_BIND=0.0.0.0

# --------------------------------------------------------------------------
# 容器名与镜像名 / 标签。
# 镜像在远端由 `docker build -t <IMAGE_NAME>:<IMAGE_TAG>` 构建，
# 并额外打一个 <IMAGE_NAME>:<IMAGE_TAG>-<时间戳> 标签作为回滚点。
# --------------------------------------------------------------------------
CONTAINER_NAME=spring-labs
IMAGE_NAME=spring-labs
IMAGE_TAG=jdwp

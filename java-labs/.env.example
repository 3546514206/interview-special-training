# 数据库面试练习库连接信息 - 模板
# ⚠️ 复制本文件为 .env 后填入实际值（在仓库根目录执行）:
#     cp java-labs/.env.example java-labs/.env  &&  $EDITOR java-labs/.env
# .env 已在 .gitignore 中(规则 **/.env),不会 commit;本文件作为提交版占位模板

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 从库（可选，只读实验实例；没有从库可以留空）
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DB_REPLICA_NAME=
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=

# Kafka 实验配置（可选，留空则用代码内默认值）
# KAFKA_BOOTSTRAP_SERVERS 默认 localhost:9092
# KAFKA_TOPIC            默认 demo-topic
# KAFKA_GROUP_ID         默认 kafka-demo-group
# KAFKA_SEND_INTERVAL_MS 默认 1000（毫秒）
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=
KAFKA_GROUP_ID=
KAFKA_SEND_INTERVAL_MS=
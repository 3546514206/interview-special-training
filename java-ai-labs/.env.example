# 本机私有配置模板（提交版）
# 复制为同目录下的 .env 后填入真实值；.env 已被仓库根 .gitignore 忽略。

# ---------------------------------------------------------------- Qdrant 向量库
# 实验专用独立集合（不会触碰已有的其它集合）；端点与 token 填你自己环境的值
QDRANT_BASE_URL=http://<your-qdrant-host>:6333
QDRANT_TOKEN=在此填入 api-key
QDRANT_COLLECTION=java_ai_labs_knowledge
QDRANT_DISTANCE=Cosine
# 向量维度必须与 EmbeddingModel.dimensions() 一致；换 embedding 模型必须重建集合
QDRANT_DIM=256

# ---------------------------------------------------------------- 真实模型
# OpenAI 兼容协议（Qwen / DeepSeek / OpenAI / 内部网关均可）。
# 不配置时，整条 RAG + Agent 链路走 core/mock 下的本地确定性实现，照样可跑可回归。
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=qwen-plus
# OPENAI_TIMEOUT_MS=30000
